{
  "name": "react-three-engine",
  "version": "0.0.1",
  "description": "React Three Fiber engine with WebGPU support",
  "keywords": [
    "fiber",
    "react",
    "three",
    "vite",
    "webgpu"
  ],
  "license": "MIT",
  "author": "",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./dist/vitePlugin.d.ts",
      "import": "./dist/vitePlugin.js",
      "require": "./dist/vitePlugin.cjs"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "flexlayout-react": "^0.8.18",
    "koota": "0.6.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "0.182.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "0.182.0",
    "tsdown": "^0.20.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "three": ">=0.160.0"
  },
  "packageManager": "pnpm@10.20.0"
}
