{
  "name": "react-three-engine",
  "version": "0.0.1",
  "description": "React Three Fiber engine with WebGPU support",
  "keywords": [
    "react",
    "three",
    "fiber",
    "webgpu",
    "vite"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./vite": {
      "import": "./dist/vitePlugin.js",
      "require": "./dist/vitePlugin.cjs",
      "types": "./dist/vitePlugin.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@react-three/fiber": "^9.0.0",
    "@react-three/drei": "^10.0.0",
    "three": "0.182.0",
    "koota": "0.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "0.182.0",
    "tsdown": "^0.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "three": ">=0.160.0"
  },
  "packageManager": "pnpm@10.20.0"
}
